@page
@model ProjectNoy.Pages.Users.LoginModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "התחברות";
}

<div class="container mt-5">
    <h2>התחברות למערכת</h2>

    <form method="post" class="col-md-6 mt-4">
        <div class="mb-3">
            <label class="form-label">שם משתמש:</label>
            <input type="text" asp-for="Username" class="form-control" required />
        </div>

        <div class="mb-3">
            <label class="form-label">סיסמה:</label>
            <input type="password" asp-for="Password" class="form-control" required />
        </div>

        <button type="submit" class="btn btn-primary">התחבר</button>
    </form>


    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger mt-3 col-md-6">
            @Model.ErrorMessage
        </div>
    }
    <br />
    <a href="/Users/Register">עוד לא רשום? להרשמה</a>
</div>

<script src="~/js/login.js"></script>
</div>