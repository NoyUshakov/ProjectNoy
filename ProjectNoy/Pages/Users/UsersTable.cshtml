@page
@model ProjectNoy.Pages.Users.UsersTableModel
@using System.Data

<div class="container mt-4 text-white">
    <h1 class="mb-4 text-center fw-bold" style="color: #0d6efd;">👥 Users Table Management</h1>

    <div class="row g-3 mb-4 bg-dark p-3 rounded shadow-sm border border-secondary">
        <div class="col-md-3">
            <form method="post" asp-page-handler="Delete">
                <label class="form-label text-light small fw-bold">Delete User:</label>
                <div class="input-group">
                    <input asp-for="UserId" class="form-control" placeholder="User ID">
                    <button class="btn btn-danger" type="submit">Delete</button>
                </div>
            </form>
        </div>
    </div>

    <div class="table-responsive bg-dark p-3 rounded">
        <table class="table table-dark table-striped">
            <thead>
                <tr>
                    @if (Model.dt != null)
                    {
                        @foreach (DataColumn column in Model.dt.Columns)
                        {
                            <th>@column.ColumnName</th>
                        }
                    }
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.dt != null)
                {
                    @foreach (DataRow row in Model.dt.Rows)
                    {
                        <tr>
                            @foreach (DataColumn column in Model.dt.Columns)
                            {
                                <td>@row[column]</td>
                            }
                            <td>
                                <a asp-page="/Users/Update" asp-route-id="@row["Id"]" class="btn btn-sm btn-outline-warning">Update</a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>