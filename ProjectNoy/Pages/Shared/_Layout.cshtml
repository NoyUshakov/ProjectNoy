@using Microsoft.AspNetCore.Http
@{
    // תיקון: שינוי ל-L גדולה כדי שיתאים בדיוק למה שנשמר ב-Login.cshtml.cs
    var sessionValue = Context.Session.GetString("Username");

    // אם תרצה להחזיר את ה-Session של האדמין בעתיד, שים לב גם פה ל-A גדולה:
    var adminValue = Context.Session.GetString("Admin");
   // var adminValue = true;
}

<!DOCTYPE html>
<html lang="he" dir="rtl">
 @* הוספתי dir="rtl" כדי שהתפריט העברי ישב יפה מימין לשמאל *@
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ProjectNoy</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ProjectNoy.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm bg-dark navbar-dark">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index"><img style="width:100px;height:100px" src="~/images/icon.png" /></a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">

                        <li class="nav-item">
                            <a class="nav-link text-light" asp-area="" asp-page="/classical">מוזיקה קלאסית</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-area="" asp-page="/rap">היפ-הופ/ראפ</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-area="" asp-page="/rock">רוק</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-area="" asp-page="/pop">פופ</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-light" asp-page="/Users/Login">התחבר</a>
                        </li>
                        @if (adminValue == "True")
                        {
                            <li class="nav-item">
                                <a class="nav-link text-light" asp-area="" asp-page="/Users/UsersTable">טבלת משתמשים</a>
                            </li>
                        }
                    </ul>

                    @if (string.IsNullOrEmpty(sessionValue))
                    {
                        <span class="navbar-text text-light">שלום אורח!</span>
                    }
                    else
                    {
                        <span class="navbar-text text-light me-3">welcome @sessionValue</span>
                        <div class="d-flex">
                            <a class="btn btn-outline-light btn-sm ms-1" href="/Users/Logout" role="button">התנתק</a>
                        </div>
                    }
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - אתר המוזיקה - <a asp-area="" asp-page="/Privacy"></a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>